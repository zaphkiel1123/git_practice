# Full pipeline (put your .data files in ./data/)
./run_trading.sh ./data 1min 1.5

# Or step by step:
python train_trading_model.py ./data --rr 1.5
python backtester.py ./data/models --rr 1.5
python explain_model.py ./data/models --trades ./data/models/backtest_trades.csv
python generate_trade_output.py ./data/models --data ./data/

# Generate per-trade viewer files (30 bars context before entry):
python generate_trade_output.py ./data/models --data ./data/ --per-trade
# Custom context (50 bars before entry):
python generate_trade_output.py ./data/models --data ./data/ --per-trade --context-bars 50

# Live signals:
python live_signal.py ./data/models --file new_session.data
python live_signal.py ./data/models --watch /path/to/live/

# Pipeline data flow:
#
# train_trading_model.py
#   consumes: ./data/*.data (57-byte tick binary files)
#   generates: ./data/models/signal_model.joblib
#              ./data/models/volatility_model.joblib
#              ./data/models/quality_model.joblib
#              ./data/models/training_meta.json
#              ./data/models/training_features.parquet (or .csv)
#
# backtester.py
#   consumes: ./data/models/signal_model.joblib
#             ./data/models/volatility_model.joblib
#             ./data/models/quality_model.joblib
#             ./data/models/training_meta.json (feature column list)
#             ./data/models/training_features.parquet (or --data for raw .data files)
#   generates: ./data/models/backtest_trades.csv
#              ./data/models/equity_curve.csv
#              ./data/models/backtest_metrics.json
#
# explain_model.py
#   consumes: ./data/models/signal_model.joblib
#             ./data/models/training_meta.json
#             ./data/models/training_features.parquet
#             ./data/models/backtest_trades.csv (--trades)
#   generates: ./data/models/factor_analysis.json
#              ./data/models/factor_report.txt
#
# generate_trade_output.py
#   consumes: ./data/*.data (raw 57-byte tick files)
#             ./data/models/backtest_trades.csv
#   generates (weekly mode, default):
#              ./data/models/viewer_output/{YYYY-WNN}.data (tick data per week)
#              ./data/models/viewer_output/{YYYY-WNN}.json (trades per week)
#   generates (--per-trade mode):
#              ./data/models/viewer_output/trades/trade_NNNN_{date}_{D}_{R}.data
#              ./data/models/viewer_output/trades/trade_NNNN_{date}_{D}_{R}.json
